# ─── SDR Intelligence Engine — Environment Variables ───
# Copy this file to .env and fill in real values. Never commit .env to git.
#
# ──────────────────────────────────────────────────────────────────────────
# 🎉 NO AI API KEY NEEDED! This app uses Pollinations.ai — a free, keyless
#    text-generation service. No sign-up, no credit card, no configuration.
# ──────────────────────────────────────────────────────────────────────────

# ─── Database ───
# This app is configured for PostgreSQL (Neon recommended).
#
# Get a FREE Postgres database at https://neon.tech (0.5GB free, no credit card).
# When creating a Neon project, choose region "AWS US East (Ohio) - us-east-2"
# to match Vercel's default region for lowest latency.
#
# Use the POOLED connection string (has "-pooler" in the hostname) — it handles
# serverless connection management on Vercel much better than the direct one.
#
# Format:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# ─── NextAuth.js ───
# Generate a random secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-string"

# The public URL of your app. For local dev: http://localhost:3000
# For production: https://your-app.vercel.app (or your custom domain)
NEXTAUTH_URL="http://localhost:3000"

# ─── AI Provider ───
# This app uses Pollinations.ai (https://pollinations.ai) — a free, keyless
# AI service. No API key, no sign-up, no credit card required.
#
# The endpoint and model are configured in src/app/api/analyze/route.ts:
#   - URL: https://text.pollinations.ai/
#   - Model: "openai" (GPT-4o-mini equivalent via Pollinations)
#
# If you ever want to swap providers (Gemini, OpenAI, Anthropic, Groq, etc.),
# edit src/app/api/analyze/route.ts and add the relevant env var here.
